{
  "name": "rcllr-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test 'packages/*/test/*.test.ts'",
    "test:blackbox": "node --test 'packages/cli/test/blackbox/*.test.ts'",
    "test:toml": "sh scripts/toml-test.sh",
    "test:blackbox:dist": "pnpm build && RCLLR_BIN=\"$PWD/packages/cli/bin/rcllr\" node --test 'packages/cli/test/blackbox/*.test.ts'",
    "pack:check": "sh scripts/pack-check.sh",
    "bench": "node scripts/bench.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.5",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  }
}
